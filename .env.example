# nessoo-inventory (admin.nessoo.com)
#
# This app deliberately holds exactly ONE secret. It does NOT get
# BETTER_AUTH_SECRET and it does NOT get homey-ux's DATABASE_URL — sessions are
# validated through the validate_admin_session() SQL function, so no local
# signature verification and no direct table access are needed.

# Connection string for the least-privilege `nessoo_admin_app` Postgres role.
# See sql/admin-role.sql for exactly what this role can and cannot touch.
# Do NOT append ?sslmode=... — the app pins Amazon's RDS CA itself and
# verifies the server certificate; sslmode in the URL overrides that config.
DATABASE_URL=postgres://nessoo_admin_app:PASSWORD@HOST:5432/DBNAME

# Comma-separated allowlist of admin email addresses.
# This is the one access layer NOT rooted in the database: even if a bug
# elsewhere flipped someone's platform_role to super_admin, they still cannot
# get in unless their address is also listed here.
ADMIN_EMAIL_ALLOWLIST=

# Comma-separated hosts this app is allowed to serve on. Anything else 404s.
# Keeps an unauthenticated copy from being reachable on a *.vercel.app preview.
ADMIN_ALLOWED_HOSTS=admin.nessoo.com,localhost:3000

# Where to send an unauthenticated visitor to sign in.
SIGN_IN_URL=https://app.nessoo.com/sign-in
